{
  "_comment": "三维线路示例：出站 -> 干扰 -> 覆盖空洞 -> 隧道 -> 弯道爬坡 -> 停站 -> 出站。格式见 FORMAT.md",

  "tech": "4g",

  "defaults": {
    "car_loss_db": 24,
    "edge_rsrp_dbm": -110,
    "cell": {
      "side": "left", "offset_m": 50, "height_m": 35,
      "tx_dbm": 46, "range_mode": "soft", "antenna": { "type": "omni" }
    },
    "tunnel_cell_spacing_m": 500,
    "tunnel_loss_db": 40
  },

  "track": {
    "points": [[0, 0, 0], [6000, 0, 0], [9000, 2000, 10], [12000, 2000, 10]]
  },

  "timeline": {
    "0-10":    { "speed_kmh": [0, 100] },
    "10-40":   { "speed_kmh": [100, 350] },
    "40-60":   { "speed_kmh": 350 },
    "60-80":   { "speed_kmh": 350, "interference_dbm": -85 },
    "80-100":  { "speed_kmh": 350, "tunnel": true },
    "100-130": { "speed_kmh": [350, 0] },
    "130-150": { "speed_kmh": 0, "_comment": "车站停靠 20 s" },
    "150-210": { "speed_kmh": [0, 250] }
  },

  "cell_grid": [
    { "from_m": 1200, "to_m": 3600, "spacing_m": 1200, "side": "alternate",
      "offset_m": 40, "range_m": 800, "id_prefix": "A",
      "_comment": "1.2-3.6 km 每 1200 m 一站，左右交替，离轨道 40 m" },
    { "from_m": 8400, "to_m": 11400, "spacing_m": 1000, "side": "alternate",
      "offset_m": 30, "height_m": 40, "range_m": 700, "id_prefix": "B",
      "_comment": "弯道后加密到 1000 m" }
  ],

  "cells": [
    { "id": "S", "track_m": 10, "side": "right", "offset_m": 25, "height_m": 30,
      "range_m": 600, "_comment": "车站旁的基站：线路 10 m 处，右侧 25 m" },
    { "id": "C", "track_m": 3000, "side": "right", "offset_m": 80, "height_m": 40,
      "tx_dbm": 43,
      "antenna": { "type": "sector", "azimuth_deg": 0, "tilt_deg": 4,
                   "beamwidth_deg": 65, "gain_dbi": 15 },
      "_comment": "定向扇区，主瓣沿线路前进方向（+x）" },
    { "id": "E", "track_m": 4800, "offset_m": 60, "range_m": 300, "range_mode": "hard",
      "_comment": "硬边界 300 m：E 之后到隧道口约 800 m 只剩远处的弱信号，形成覆盖空洞" },
    { "id": "P", "pos": [9800, 2300, 60],
      "_comment": "山坡上的基站，用绝对坐标给出（离轨道约 300 m）" }
  ],

  "interferers": [
    { "id": "J1", "track_m": 3000, "side": "left", "offset_m": 200, "height_m": 20,
      "range_m": 500, "power_dbm": -80, "_comment": "线路左侧 200 m 的干扰源" }
  ]
}
